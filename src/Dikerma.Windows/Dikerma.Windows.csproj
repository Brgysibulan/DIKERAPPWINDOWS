<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>DIKERMA</AssemblyName>
    <RootNamespace>Dikerma.Windows</RootNamespace>
    <Product>DIKERMA Barangay ID Maker</Product>
    <Title>DIKERMA Barangay ID Maker</Title>
    <Description>Offline Windows Barangay ID Maker with advanced Layout Studio</Description>
    <Company>JOSHUAPUDI</Company>
    <Authors>JOSHUAPUDI</Authors>
    <Copyright>Copyright © JOSHUAPUDI 2026</Copyright>

    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>

    <ApplicationIcon>Assets\dikerma.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dikerma.ico" />
    <PackageReference Include="PDFsharp-wpf" Version="6.2.4" />
  </ItemGroup>
</Project>
